# Shared Telegram Bot Token (from BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyZ

# App secret for session signing (run python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Cryptography Fernet key for encrypting bot tokens at rest (run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=dGhpcy1pcy1hLXRlc3QtZmVybmV0LWtleS0xMjM0NTY3ODk9

# Public base URL of your application (used for webhooks and Telegram links)
PUBLIC_BASE_URL=http://localhost:8000

# Optional Gemini API key for FAQ enrichment & PDF extraction
GEMINI_API_KEY=

# Database Connection URL (SQLite default, PostgreSQL supported)
DATABASE_URL=sqlite:///./botbuilder.db

# Debug & Feature Flags
DEBUG=true
ENABLE_MANAGED_BOTS=false
